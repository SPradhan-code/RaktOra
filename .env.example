# Server Environment Configuration
PORT=5000
NODE_ENV=production

# CORS & Deployment Frontend Origins (Render, custom domain, or local dev)
# Comma-separated list of permitted origins
ALLOWED_ORIGINS=https://raktora.onrender.com,http://localhost:5173
FRONTEND_URL=https://raktora.onrender.com

# Database Settings (Compatible with Aiven MySQL / Render / Local MySQL)
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Authentication & Security Secrets (JWT_SECRET must be at least 16 characters in production)
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
# Admin onboarding security key (Required to register an administrator account)
ADMIN_REGISTRATION_SECRET=

# ============================================================================
# Centralized Feature Flags (All optional external integrations default to false)
# ============================================================================
ENABLE_SMS_OTP=false
ENABLE_EMAIL_OTP=false
ENABLE_DIGILOCKER=false
ENABLE_GOVT_IDENTITY_VERIFICATION=false
ENABLE_GEOCODING=false

# Email Provider Configuration (Resend Transactional API - used when ENABLE_EMAIL_OTP=true)
RESEND_API_KEY=
EMAIL_FROM=

# SMS Provider Configuration (MSG91 Indian SMS API - used when ENABLE_SMS_OTP=true)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# DigiLocker Identity Verification OAuth 2.0 (used when ENABLE_DIGILOCKER=true)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/auth/digilocker/callback
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in

# Local Development Emulation (Keep false in production)
OTP_DEV_MODE=false
DIGILOCKER_DEV_MODE=false
