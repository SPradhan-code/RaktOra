# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Database Settings (Compatible with Aiven MySQL / Render / Local MySQL)
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Authentication & Security Secrets
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# Email Provider Configuration (Resend Transactional API)
RESEND_API_KEY=
EMAIL_FROM=

# SMS Provider Configuration (MSG91 Indian SMS API)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Local Development OTP Bypass (Must default to false; never enable in production)
OTP_DEV_MODE=false

# DigiLocker Identity Verification OAuth 2.0 Configuration
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/auth/digilocker/callback
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in
DIGILOCKER_DEV_MODE=false

